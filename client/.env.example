# Copy to client/.env.local and fill in. VITE_* values are bundled into the browser. No secrets here.
VITE_API_URL=http://localhost:4000

# Firebase Console > Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Sign-in uses the Firebase Google provider (enable it in Firebase Console > Authentication).
# UCSD Google accounts redirect to UCSD SSO + Duo automatically.
VITE_ALLOWED_EMAIL_DOMAIN=ucsd.edu

# Browser key restricted by HTTP referrer (Maps JavaScript + Places)
VITE_GOOGLE_MAPS_API_KEY=
