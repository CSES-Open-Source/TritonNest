# Copy to server/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local Docker default; use your Atlas URI for shared dev)
MONGODB_URI=mongodb://localhost:27017/tritonnest

# Only emails on this domain may use the app
ALLOWED_EMAIL_DOMAIN=ucsd.edu

# Firebase Admin: Firebase Console > Project settings > Service accounts > Generate new private key.
# Recommended: keep the file OUTSIDE the repo and point to it with an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/tritonnest/firebase-admin.json
# Alternative (e.g. for hosting providers): paste the whole JSON on one line instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Google Maps (server-side key for Distance Matrix / Places)
GOOGLE_MAPS_API_KEY=
